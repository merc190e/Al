# Optional GeckoTerminal network slug for Robinhood Chain.
# Other supported chains use built-in GeckoTerminal network slugs.
GECKOTERMINAL_NETWORK_ROBINHOOD=
# Native quote symbol for Robinhood Chain (required to monitor native-quote pairs).
NATIVE_QUOTE_SYMBOL_ROBINHOOD=

# Required for the manually-confirmed trade API. Use a long, random value.
TRADING_API_TOKEN=
# Live swaps are disabled unless a private key is configured on the server.
# Never expose this key in the dashboard or commit a populated .env file.
TRADING_PRIVATE_KEY=

# Configure RPC URLs and DEX router contract addresses for chains you will trade:
# TRADING_RPC_URL_ETHEREUM=
# DEX_ROUTER_ETHEREUM=
# TRADING_RPC_URL_BSC=
# DEX_ROUTER_BSC=
# TRADING_RPC_URL_ARBITRUM=
# DEX_ROUTER_ARBITRUM=
# TRADING_RPC_URL_ROBINHOOD=
# DEX_ROUTER_ROBINHOOD=
# TRADING_CHAIN_ID_ROBINHOOD=
