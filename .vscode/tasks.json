{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run FastAPI bot",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"uvicorn",
				"main:app",
				"--app-dir",
				"bot",
				"--host",
				"0.0.0.0",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Streamlit app",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"streamlit",
				"run",
				"BotAl/app.py",
				"--server.headless",
				"true",
				"--server.port",
				"8501"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run dex-bot Next.js",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"bota/dex-bot",
				"run",
				"dev",
				"--",
				"--hostname",
				"0.0.0.0",
				"--port",
				"3001"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}